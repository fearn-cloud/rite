{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h",
    "retention": {
      "dryRun": false,
      "delay": "24h",
      "policies": [
        {
          "repositories": ["**"],
          "deleteUntagged": true,
          "keepTags": [{"mostRecentlyPulledCount": 5}]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": ["docker2s2"]
  },
  "log": {"level": "info"},
  "extensions": {
    "metrics": {
      "enable": true,
      "prometheus": {"path": "/metrics"}
    },
    "search": {"enable": true},
    "ui": {"enable": true},
    "sync": {
      "enable": true,
      "registries": [
        {"urls": ["https://registry-1.docker.io"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/docker.io"}]},
        {"urls": ["https://ghcr.io"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/ghcr.io"}]},
        {"urls": ["https://lscr.io"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/lscr.io"}]},
        {"urls": ["https://codeberg.org"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/codeberg.org"}]},
        {"urls": ["https://registry.gitlab.com"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/registry.gitlab.com"}]},
        {"urls": ["https://registry.k8s.io"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/registry.k8s.io"}]},
        {"urls": ["https://quay.io"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/quay.io"}]},
        {"urls": ["https://public.ecr.aws"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/public.ecr.aws"}]},
        {"urls": ["https://mcr.microsoft.com"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/mcr.microsoft.com"}]},
        {"urls": ["https://gcr.io"], "onDemand": true, "tlsVerify": true, "preserveDigest": true, "content": [{"prefix": "**", "destination": "/gcr.io"}]}
      ]
    }
  }
}
