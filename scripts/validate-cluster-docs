#!/usr/bin/env python3
"""Validate Cluster-context documentation and its one-way substrate boundary."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse


MARKDOWN_LINK = re.compile(r"(?<!!)\[[^\]]*\]\(([^)\s]+)(?:\s+[^)]*)?\)")
FORBIDDEN_SUBSTRATE_IMPORT = re.compile(
    r"^\s*(?:from|import)\s+(?:fortress_inventory|fortress_services|fortress_tofu)(?:\.|\s)",
    re.MULTILINE,
)


def validate_markdown_links(cluster_docs: Path) -> list[str]:
    errors: list[str] = []
    for document in cluster_docs.rglob("*.md"):
        for target in MARKDOWN_LINK.findall(document.read_text()):
            parsed = urlparse(target)
            if parsed.scheme or parsed.netloc or target.startswith("#"):
                continue
            target_path = unquote(parsed.path)
            if not target_path:
                continue
            if not (document.parent / target_path).resolve().exists():
                errors.append(
                    f"{document.relative_to(cluster_docs.parent.parent)}: "
                    f"missing local Markdown target {target_path}"
                )
    return errors


def validate_dependency_boundary(root: Path) -> list[str]:
    cluster_code = root / "fortress_cluster"
    if not cluster_code.exists():
        return []

    errors: list[str] = []
    for source in cluster_code.rglob("*.py"):
        if FORBIDDEN_SUBSTRATE_IMPORT.search(source.read_text()):
            errors.append(
                f"{source.relative_to(root)}: forbidden substrate dependency; "
                "Cluster code must consume its internal interface rather than raw Substrate Inventory"
            )
    return errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    arguments = parser.parse_args()
    root = arguments.root.resolve()
    cluster_docs = root / "docs" / "cluster"

    errors = validate_dependency_boundary(root)
    if not cluster_docs.is_dir():
        errors.append("docs/cluster: missing Cluster domain context")
    else:
        errors.extend(validate_markdown_links(cluster_docs))

    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
